{
  "name": "SIGLA - Notificacoes WhatsApp (Uazap)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sigla-notificacoes",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1111111-1111-1111-1111-111111111111",
      "name": "Webhook SIGLA",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "sigla-notificacoes"
    },
    {
      "parameters": {
        "jsCode": "// Valida o header Authorization contra SIGLA_NOTIFICACOES_WEBHOOK_TOKEN (se houver).\n// Fail-open quando $env nao esta acessivel (ex.: n8n cloud) ou quando o token nao foi configurado.\nlet expected = '';\ntry { expected = $env.SIGLA_NOTIFICACOES_WEBHOOK_TOKEN || ''; } catch (e) { expected = ''; }\nconst headers = $input.first().json.headers || {};\nconst auth = headers.authorization || headers.Authorization || '';\nif (expected && auth !== 'Bearer ' + expected) {\n  throw new Error('Token invalido (header Authorization).');\n}\nreturn $input.all();"
      },
      "id": "a2222222-2222-2222-2222-222222222222",
      "name": "Validar token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UAZAP_BASE_URL }}/send/text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "token", "value": "={{ $env.UAZAP_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"number\": \"{{ $json.body.recipientPhone }}\", \"text\": {{ JSON.stringify($json.body.message) }} }",
        "options": {}
      },
      "id": "a3333333-3333-3333-3333-333333333333",
      "name": "Enviar Uazap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'sent', eventId: $('Webhook SIGLA').item.json.body.eventId, uazap: $json }) }}",
        "options": {}
      },
      "id": "a4444444-4444-4444-4444-444444444444",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 300]
    }
  ],
  "connections": {
    "Webhook SIGLA": {
      "main": [[{ "node": "Validar token", "type": "main", "index": 0 }]]
    },
    "Validar token": {
      "main": [[{ "node": "Enviar Uazap", "type": "main", "index": 0 }]]
    },
    "Enviar Uazap": {
      "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateId": "sigla-notificacoes-whatsapp" },
  "tags": [{ "name": "SIGLA" }]
}
