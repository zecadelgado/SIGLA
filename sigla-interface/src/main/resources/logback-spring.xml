<configuration>

    <!-- Pasta de logs no diretorio do usuario: nao polui o diretorio de trabalho
         e funciona mesmo quando o app roda a partir de um instalador. -->
    <property name="PASTA_LOGS" value="${user.home}/.sigla/logs"/>
    <property name="PADRAO" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <!-- Log completo da aplicacao, com rotacao diaria e limite de espaco. -->
    <appender name="ARQUIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PASTA_LOGS}/sigla.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${PASTA_LOGS}/sigla.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <!-- Apenas avisos e erros, para diagnostico rapido sem ruido de INFO. -->
    <appender name="ARQUIVO_ERROS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PASTA_LOGS}/sigla-erros.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${PASTA_LOGS}/sigla-erros.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <logger name="br.com.sigla" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ARQUIVO"/>
        <appender-ref ref="ARQUIVO_ERROS"/>
    </root>
</configuration>
