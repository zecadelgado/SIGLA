<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="790.0" prefWidth="1530.0" spacing="16.0" style="-fx-background-color: lightgrey;" styleClass="screen-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.sigla.interfacegrafica.controlador.ControladorUsuarios">
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
   </padding>
   <children>
      <Label fx:id="title" text="Usuários" textFill="#00417e">
         <font>
            <Font name="Ebrima Bold" size="40.0" />
         </font>
      </Label>
      <HBox spacing="12.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onNovoUsuario" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #0B2A6F; -fx-background-radius: 5;" text="+ Novo usuário" textFill="WHITE">
               <font>
                  <Font name="Ebrima Bold" size="16.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onTrocarSenha" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: white; -fx-background-radius: 5;" text="Trocar senha" textFill="#0B2A6F">
               <font>
                  <Font name="Ebrima Bold" size="16.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onAtualizar" prefHeight="40.0" prefWidth="130.0" style="-fx-background-color: white; -fx-background-radius: 5;" text="Atualizar" textFill="#0B2A6F">
               <font>
                  <Font name="Ebrima Bold" size="16.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="usuariosTable" prefHeight="620.0" prefWidth="1470.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="nomeColumn" prefWidth="320.0" text="Nome" />
            <TableColumn fx:id="usuarioColumn" prefWidth="240.0" text="Usuário" />
            <TableColumn fx:id="emailColumn" prefWidth="360.0" text="E-mail" />
            <TableColumn fx:id="tipoColumn" prefWidth="200.0" text="Tipo" />
            <TableColumn fx:id="statusColumn" prefWidth="160.0" text="Status" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
