<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="790.0" prefWidth="1530.0" spacing="14.0" style="-fx-background-color: lightgrey;" styleClass="screen-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.sigla.interfacegrafica.controlador.ControladorAlertas">
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
   </padding>
   <children>
      <Label fx:id="title" text="Alertas" textFill="#00417e">
         <font>
            <Font name="Ebrima Bold" size="40.0" />
         </font>
      </Label>
      <Label text="O que precisa de atenção agora (dê duplo clique para abrir a tela relacionada)" textFill="#303030">
         <font>
            <Font name="Ebrima" size="16.0" />
         </font>
      </Label>
      <HBox spacing="14.0">
         <children>
            <VBox alignment="CENTER" prefWidth="230.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label fx:id="lblContratos" text="0" textFill="#0B2A6F"><font><Font name="Ebrima Bold" size="30.0" /></font></Label>
                  <Label text="Contratos vencendo" textFill="#303030"><font><Font name="Ebrima" size="14.0" /></font></Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefWidth="230.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label fx:id="lblCertificados" text="0" textFill="#0B2A6F"><font><Font name="Ebrima Bold" size="30.0" /></font></Label>
                  <Label text="Certificados vencendo" textFill="#303030"><font><Font name="Ebrima" size="14.0" /></font></Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefWidth="230.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label fx:id="lblVisitasProximas" text="0" textFill="#0B2A6F"><font><Font name="Ebrima Bold" size="30.0" /></font></Label>
                  <Label text="Visitas próximas" textFill="#303030"><font><Font name="Ebrima" size="14.0" /></font></Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefWidth="230.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label fx:id="lblVisitasPerdidas" text="0" textFill="#B45309"><font><Font name="Ebrima Bold" size="30.0" /></font></Label>
                  <Label text="Visitas não realizadas" textFill="#303030"><font><Font name="Ebrima" size="14.0" /></font></Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefWidth="230.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label fx:id="lblParcelas" text="0" textFill="#B45309"><font><Font name="Ebrima Bold" size="30.0" /></font></Label>
                  <Label text="Parcelas em atraso" textFill="#303030"><font><Font name="Ebrima" size="14.0" /></font></Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefWidth="230.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <Label fx:id="lblFalhas" text="0" textFill="#B91C1C"><font><Font name="Ebrima Bold" size="30.0" /></font></Label>
                  <Label text="Falhas de envio" textFill="#303030"><font><Font name="Ebrima" size="14.0" /></font></Label>
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox spacing="12.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onAtualizar" prefHeight="38.0" prefWidth="140.0" style="-fx-background-color: #0B2A6F; -fx-background-radius: 5;" text="Atualizar" textFill="WHITE">
               <font>
                  <Font name="Ebrima Bold" size="15.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onReprocessarFalhas" prefHeight="38.0" prefWidth="180.0" style="-fx-background-color: #B45309; -fx-background-radius: 5;" text="Reprocessar falhas" textFill="WHITE">
               <font>
                  <Font name="Ebrima Bold" size="15.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="alertasTable" VBox.vgrow="ALWAYS">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
